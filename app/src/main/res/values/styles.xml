<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Title" parent="Heading">
        <item name="android:textSize">32sp</item>
    </style>
    <style name="Big" parent="Heading">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">46sp</item>
        <item name="android:textColor">@color/accent_free</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="Caption" parent="Body">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Secondary" parent="Body">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Metric" parent="Body">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">@color/panel_bg</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingHorizontal">28dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/panel_bg</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/action_button_bg</item>
    </style>
    <style name="ZoomButton" parent="ActionButton">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">112dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">48sp</item>
    </style>
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/text_secondary</item>
    </style>
</resources>
